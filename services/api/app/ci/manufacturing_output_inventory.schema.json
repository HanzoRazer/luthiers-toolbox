{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["base_sha", "historical_audit", "current", "reconciliation", "rows"],
  "properties": {
    "base_sha": {"type": "string", "minLength": 40},
    "historical_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["broad_candidates", "handler_identities", "high_signal"],
      "properties": {
        "broad_candidates": {"type": "integer"},
        "handler_identities": {"type": "integer"},
        "high_signal": {"type": "integer"}
      }
    },
    "current": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidates", "handler_identities", "high_signal"],
      "properties": {
        "candidates": {"type": "integer"},
        "handler_identities": {"type": "integer"},
        "high_signal": {"type": "integer"}
      }
    },
    "reconciliation": {"type": "string", "minLength": 20},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method", "path", "route_name", "handler", "source_file",
          "response_carrier", "classification", "implementation_kind",
          "implementation_symbol", "delegates_to", "authentication",
          "authority_layer", "authority_key", "authority_order",
          "containment", "proof_status", "evidence", "notes"
        ],
        "properties": {
          "method": {"type": "string"},
          "path": {"type": "string"},
          "route_name": {"type": "string"},
          "handler": {"type": "string"},
          "source_file": {"type": "string"},
          "response_carrier": {"enum": ["json_field", "attachment", "stream", "websocket", "none", "unknown"]},
          "classification": {"enum": ["CONFIRMED_EMITTER", "CONFIRMED_DELEGATE", "NON_EMITTING", "UNEXAMINED"]},
          "implementation_kind": {"enum": ["class", "function", "inline", "delegate", "postprocessor", "unknown"]},
          "implementation_symbol": {"type": ["string", "null"]},
          "delegates_to": {"type": ["string", "null"]},
          "authentication": {"enum": ["NONE", "OPTIONAL", "REQUIRED", "UNKNOWN"]},
          "authority_layer": {"enum": ["readiness", "manufacturing_output", "asset", "other", "none", "unknown"]},
          "authority_key": {"type": ["string", "null"]},
          "authority_order": {"enum": ["before_generation", "after_generation", "none", "unknown"]},
          "containment": {"enum": ["FAIL_CLOSED", "PERMITTED_BY_AUTHORITY", "LIVE_UNGOVERNED", "UNKNOWN", "NOT_APPLICABLE"]},
          "proof_status": {"enum": ["RUNTIME_PROVED", "SOURCE_PROVED", "MECHANICALLY_DISCOVERED", "UNEXAMINED"]},
          "evidence": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}

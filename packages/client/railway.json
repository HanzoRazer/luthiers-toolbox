{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "src/**",
      "*.ts",
      "*.vue",
      "*.json",
      "Dockerfile",
      "scripts/**",
      "package-lock.json"
    ]
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "/bin/sh /start.sh",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}

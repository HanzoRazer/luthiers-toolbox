{
  "schema": "cbsp21_patch_input_v1",
  "schema_version": "cbsp21_patch_input_v1",
  "coverage_min": 0.95,
  "patch_id": "data-mig-002-mb-sound-pin",
  "title": "DATA-MIG-002: delete the duplicated MB Sound corpus and pin mb-sound/v1.0.0",
  "intent": "Toolbox stops being a second authority for MB Sound observational data. The 132-file cohort and 12 process documents are deleted after byte parity with the canonical immutable release is proven, and replaced by a dependency pin plus a fail-closed verifier.",
  "change_type": "data_custody",
  "behavior_change": "none - the corpus had no application consumer in this repository (no adapter, API route, view or test read it). No runtime, request or build path resolves the canonical corpus; verification is a manual/CI-offline step.",
  "risk_level": "medium",
  "scope": {
    "paths_in_scope": [
      "services/api/app/data_registry/system/materials/empirical_tonewood/",
      "services/api/app/data_registry/system/materials/panel_acoustic/",
      "services/api/app/data_registry/system/materials/SOURCES.md",
      "docs/reference/mb-sound/",
      "scripts/verify_reference_corpus_pin.py",
      "tests/test_mb_sound_corpus_dependency.py",
      ".cbsp21/patches/data-mig-002-mb-sound-pin.json",
      ".gitignore",
      "SPRINTS.md",
      "scripts/mb_sound_*.py"
    ],
    "files_expected_to_change": [
      ".cbsp21/patches/data-mig-002-mb-sound-pin.json",
      ".gitignore",
      "docs/reference/mb-sound/CORPUS_DEPENDENCY.json",
      "docs/reference/mb-sound/MIGRATION_DATA-MIG-002.md",
      "docs/reference/mb-sound/README.md",
      "scripts/verify_reference_corpus_pin.py",
      "tests/test_mb_sound_corpus_dependency.py",
      "services/api/app/data_registry/system/materials/SOURCES.md",
      "services/api/app/data_registry/system/materials/panel_acoustic/README.md",
      "services/api/app/data_registry/system/materials/panel_acoustic/MB_SOUND_SOURCES.md",
      "services/api/app/data_registry/system/materials/panel_acoustic/mb_sound_panels.json",
      "SPRINTS.md",
      "scripts/mb_sound_validate_corpus.py",
      "scripts/mb_sound_merge_rows.py"
    ]
  },
  "diff_articulation": {
    "what_changed": "Removed 144 files: 132 under materials/empirical_tonewood/mb_sound/ (114 specimen payloads, 6 species cohorts, 3 validation reports, cohort manifest, 2 readmes, 4 .xlsx laboratory workbooks and their artifact manifest) and 12 process documents under docs/reference/mb-sound/. Added a dependency pin, a consumer README, a custody-transfer record carrying the full 145-file hash table, a ported fail-closed verifier, and 29 contract and anti-regression tests. Repointed the panel_acoustic tombstones and materials/SOURCES.md from the deleted local path to the canonical release, and dropped the .gitignore exception that un-ignored the workbooks. Also repaired the two retained extraction scripts that still referenced the deleted local corpus path, so no retained tooling instructs a maintainer against a path this increment removed.",
    "why": "MB Sound observational data became canonical in HanzoRazer/luthier-acoustics-data at the immutable release mb-sound/v1.0.0. Holding a second normalized copy here made Toolbox a competing authority for evidence it does not measure and cannot correct.",
    "what_did_not_change": "No specimen identifier, schema, vocabulary, unit or measured value was altered. No canonical data repository, Laboratory or Tap Tone Pi change. No adapter, TonewoodEntry, wood_species.json, generator or solver change. No public API or UI surface touched.",
    "why_not_redundant": "This is not a re-run of the DO-SIP-013 intake (patch mb-sound-panel-corpus-scaffold) and not a repeat of the Laboratory pin (DATA-REL-001). Those established the corpus and proved external consumption works from one consumer. This increment does the thing neither did: it removes the duplicate from the repository that originally preserved it, so exactly one authority for MB Sound observations remains. Nothing else in the tree deletes this data or pins this release from Toolbox; without it, Toolbox stays a second, independently mutable copy of vendor measurements with no reconciliation path."
  },
  "verification": {
    "commands_run": [
      "python scripts/verify_reference_corpus_pin.py",
      "python -m pytest tests/test_mb_sound_corpus_dependency.py -q"
    ],
    "results": "Live pin resolution against the private canonical release: VERIFIED, 13/13 checks. Contract and anti-regression suite: 29 passed. Pre-deletion parity: 145/145 files byte-identical; the 114 local specimen blobs independently reproduced the canonical dataset digest ea77ca63...",
    "known_residual": "The four scripts/mb_sound_*.py extraction tools are duplicated canonically under tools/mb_sound/ in the data repository. They are retained here as non-authoritative process tooling pending a later audit; they are not evidence and no longer have a local corpus to operate on."
  },

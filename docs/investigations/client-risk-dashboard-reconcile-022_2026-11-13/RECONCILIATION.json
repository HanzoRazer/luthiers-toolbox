  "resolved_findings": {
    "RISK-L01": {
      "implementation": "packages/client/src/views/art/risk-dashboard/useRiskFilters.ts",
      "behavior": "syncFiltersToQuery trims lane, preset, job_hint, since, and until, omits a value that is empty after trimming, and does not write the trimmed text back onto the filter refs. The query object still replaces the five known keys.",
      "tests": [
        "packages/client/src/views/art/risk-dashboard/__tests__/riskDashboardDecomposed.spec.ts",
        "packages/client/src/views/art/__tests__/RiskDashboardCrossLab.spec.ts"
      ]
    },
    "RISK-L02": {
      "implementation": "packages/client/src/views/art/RiskDashboardCrossLab.vue",
      "behavior": "One watcher clears the selected bucket when lane, preset, or job hint changes. Those edits do not request /api/compare/risk_aggregate.",
      "tests": [
        "packages/client/src/views/art/__tests__/RiskDashboardCrossLab.spec.ts"
      ]
    },
    "RISK-L03": {
      "implementation": "packages/client/src/views/art/RiskDashboardCrossLab.vue",
      "behavior": "The same watcher clears the selected bucket and calls refresh once when since or until changes. Quick range, a lane preset with dates, clear filters with an active window, and a saved view that changes the window each produce one aggregate request. Mount applies the query and a default view before the watcher accepts edits, so initialization stays at one request.",
      "tests": [
        "packages/client/src/views/art/__tests__/RiskDashboardCrossLab.spec.ts"
      ]
    }
  },
  "request_order_guards": {
    "reason": "Review of PR #481 found that the date-triggered refresh added for RISK-L03 let an older aggregate response overwrite a newer one, and that clearing the selection did not cancel a pending detail request.",
    "implementations": {
      "packages/client/src/views/art/risk-dashboard/useRiskBuckets.ts": "refresh() takes a generation number. Only the newest generation may write bucketsRaw, so an older success or failure that arrives last is discarded.",
      "packages/client/src/views/art/risk-dashboard/useRiskBucketDetails.ts": "Each loadBucketDetails() call takes a generation number and clearBucketDetails() advances it. Only the current request may write entries, the error, or the loading flag.",
      "packages/client/src/views/art/risk-dashboard/useRiskExports.ts": "Bucket exports read the bucket, job hint, and date window before the request and name the file from those values. A bucket-report failure sets the error only if the same bucket is still selected."
    },
    "tests": [
      "packages/client/src/views/art/risk-dashboard/__tests__/riskDashboardRequestOrder.spec.ts"
    ]
  },
